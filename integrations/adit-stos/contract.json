    "specialistRouter": "STOSCore",
    "finalAuthority": "STOS trust spine",
    "directBrowserIngress": false,
    "direct9844Proxy": false
  },
  "preservation": {
    "dormantCompatibilityChassis": "internal/core/noema-core.html",
    "dormantChassisMutation": "DENIED_BY_THIS_INTEGRATION",
    "liveInternalCloud": "naib_internal_cloud_v1",
    "liveCloudDirectWriteFromAdit": false
  }
}
